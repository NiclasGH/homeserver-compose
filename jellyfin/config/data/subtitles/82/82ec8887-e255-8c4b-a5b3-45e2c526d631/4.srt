1
00:00:00,000 --> 00:00:15,000
<font color="#FF8040">{\an8}Downloaded From MoviesMod.Org</font>

2
00:00:47,380 --> 00:00:48,256
‫تأمّل حالك.‬

3
00:00:49,007 --> 00:00:51,092
‫- ماذا؟‬
‫- تبدو كراعي بقر حقيقي.‬

4
00:00:51,676 --> 00:00:54,095
‫بهذه السمرة والصلابة.‬

5
00:00:55,638 --> 00:00:58,475
‫بينما تبدو كأنك بقيت في نفق طوال الصيف.‬

6
00:00:58,558 --> 00:01:01,352
‫لم تمنحني الفصول الصيفية وقتًا كثيرًا‬
‫لأعمل على سمرتي.‬

7
00:01:02,687 --> 00:01:04,522
‫- كيف كانت "مونتانا"؟‬
‫- جيدة.‬

8
00:01:04,606 --> 00:01:08,359
‫كانت جيدة. تعلمت الكثير.‬
‫حسبت أن أمّنا ستأتي لتقلني.‬

9
00:01:08,943 --> 00:01:09,861
‫طرأ أمر.‬

10
00:01:11,821 --> 00:01:14,491
‫أيمكننا الذهاب؟‬
‫لم آكل منذ كنت في "وايومنغ".‬

11
00:02:05,625 --> 00:02:06,584
‫آنسة "هاورد".‬

12
00:02:08,253 --> 00:02:11,756
‫كيف كان يومك الأخير في التدريب؟‬
‫هل أصبحت محامية ذات شأن؟‬

13
00:02:11,840 --> 00:02:12,966
‫ليس بعد.‬

14
00:02:14,050 --> 00:02:15,802
‫أرسل خالك هذه.‬

15
00:02:16,511 --> 00:02:17,762
‫هل ما زال في "إيطاليا"؟‬

16
00:02:19,305 --> 00:02:20,140
‫"إسبانيا".‬

17
00:02:22,392 --> 00:02:24,269
‫آنسة "هاورد"، جاء شخص لرؤيتك.‬

18
00:02:28,648 --> 00:02:29,732
‫مرحبًا يا "جاكي".‬

19
00:02:35,196 --> 00:02:37,198
‫لا أصدّق أن هذا المكان ما زال مفتوحًا.‬

20
00:02:38,658 --> 00:02:40,994
‫أنا وأمك كنا نأتي إلى هنا طوال الوقت.‬

21
00:02:41,786 --> 00:02:43,163
‫- هل صحبتك يومًا؟‬
‫- نعم.‬

22
00:02:43,246 --> 00:02:45,623
‫حين كنت صغيرة، كنا نتناول مخفوق الحليب.‬

23
00:02:47,625 --> 00:02:48,501
‫"كاثرين".‬

24
00:02:50,003 --> 00:02:51,129
‫ماذا تفعلين هنا؟‬

25
00:02:51,212 --> 00:02:53,882
‫أعني، هل كل شيء بخير في…‬

26
00:02:55,508 --> 00:02:56,509
‫في "سيلفر فولز"؟‬

27
00:02:57,010 --> 00:02:59,095
‫نعم. كل أمورنا على ما يُرام.‬

28
00:03:01,639 --> 00:03:03,892
‫ما ليس على ما يُرام يا "جاكي"…‬

29
00:03:05,560 --> 00:03:06,394
‫هو هذا.‬

30
00:03:06,477 --> 00:03:08,938
‫"أكاديمية (غاليستون)‬
‫نموذج تسجيل طالب جديد"‬

31
00:03:10,648 --> 00:03:12,066
‫مدرسة داخلية يا "جاكي".‬

32
00:03:13,902 --> 00:03:15,320
‫أتريدينني حقًا أن أوقّع هذا؟‬

33
00:03:16,571 --> 00:03:18,364
‫- هل هذا سبب مجيئك؟‬
‫- بالطبع.‬

34
00:03:19,365 --> 00:03:21,910
‫حاولت الاتصال بـ"ريتشارد"،‬
‫لكنه في "برشلونة"؟‬

35
00:03:23,703 --> 00:03:25,371
‫هل قضى أي وقت هنا هذا الصيف؟‬

36
00:03:26,456 --> 00:03:27,665
‫يأتي ويرحل.‬

37
00:03:27,749 --> 00:03:31,711
‫لكن "داني" قضى هنا شهرًا،‬
‫ولدينا أيضًا مدبر المنزل‬

38
00:03:31,794 --> 00:03:34,881
‫و"آل"، موظف استقبال البناية. كنت بخير.‬

39
00:03:34,964 --> 00:03:38,426
‫"جاكي"، أظن أنني كنت لأتفهم‬
‫لو أنك أردت البقاء هنا في المدينة،‬

40
00:03:38,509 --> 00:03:40,345
‫- لكن "فيرمونت"؟‬
‫- إنها كلّية جيدة.‬

41
00:03:40,428 --> 00:03:45,058
‫ولا أعرف،‬
‫ارتأيت أن الذهاب إلى مكان جديد سيكون جيدًا.‬

42
00:03:45,141 --> 00:03:47,518
‫حسبت أن كل شيء يسير على ما يُرام.‬
‫لقد بدوت سعيدة.‬

43
00:03:47,602 --> 00:03:49,479
‫كان كل شيء على ما يُرام، وكنت سعيدة.‬

44
00:03:49,562 --> 00:03:51,981
‫هل حدث شيء إذًا؟‬

45
00:03:52,815 --> 00:03:53,816
‫مع "أليكس" أو…‬

46
00:03:55,235 --> 00:03:56,194
‫ربما مع شخص آخر؟‬

47
00:03:56,277 --> 00:03:59,030
‫لا. إنما…‬

48
00:04:00,281 --> 00:04:01,282
‫كان عليّ الرحيل.‬

49
00:04:01,783 --> 00:04:05,912
‫أردت الرحيل عن "سيلفر فولز".‬
‫أردت العودة إلى دياري، إلى "نيويورك"،‬

50
00:04:05,995 --> 00:04:07,747
‫إلى ما قبل…‬

51
00:04:07,830 --> 00:04:08,831
‫كل شيء.‬

52
00:04:08,915 --> 00:04:10,750
‫لكن هذه لم تعد دياري.‬

53
00:04:16,673 --> 00:04:17,590
‫لقد…‬

54
00:04:18,299 --> 00:04:21,261
‫لقد قابلت بعض أصدقائي القدامى فور عودتي.‬

55
00:04:21,928 --> 00:04:22,762
‫لكن…‬

56
00:04:23,972 --> 00:04:25,056
‫كل شيء قد تغيّر.‬

57
00:04:25,723 --> 00:04:27,850
‫أصبحت حياتي مختلفة جدًا عن حيواتهم.‬

58
00:04:28,977 --> 00:04:34,107
‫ولقد حاولت الذهاب إلى بعض الأماكن‬
‫الذي كنت أرتادها مع "لوسي"‬

59
00:04:34,190 --> 00:04:36,150
‫وأمي وأبي، مثل‬

60
00:04:37,443 --> 00:04:39,487
‫متحف "كلويسترز" ومسرح "لينكن سنتر"،‬

61
00:04:39,570 --> 00:04:43,032
‫لكنها ليست كما كانت معهم.‬

62
00:04:46,619 --> 00:04:48,037
‫جعلني ذلك أدرك‬

63
00:04:49,455 --> 00:04:51,040
‫أن هذا لم يعد مكاني.‬

64
00:04:53,334 --> 00:04:54,877
‫ليس لي أي مكان.‬

65
00:04:55,503 --> 00:04:59,590
‫لذلك عليّ أن أجد مكانًا جديدًا‬
‫وأبدأ بداية جديدة.‬

66
00:05:03,594 --> 00:05:07,056
‫أنا وأمك كنا نأتي إلى هنا‬
‫حين كانت إحدانا تمرّ بمحنة،‬

67
00:05:07,932 --> 00:05:11,227
‫كانفصال أو إذا رسبنا في اختبار.‬

68
00:05:11,311 --> 00:05:13,813
‫لكن غالبًا ما كنت أرسب وحدي،‬
‫فأمك لم تفشل قط في شيء.‬

69
00:05:15,940 --> 00:05:21,988
‫ولقد أدركنا أن لا مشكلة لا يمكن حلها‬
‫بما يكفي من الزبدة والشوكولاتة والكلام.‬

70
00:05:22,989 --> 00:05:26,367
‫- يسرني أنها حظت بك لتتحدث إليها.‬
‫- مع الأسف كنت أتحدّث أكثر منها.‬

71
00:05:27,493 --> 00:05:29,370
‫كانت أمك مستمعة جيدة جدًا.‬

72
00:05:32,165 --> 00:05:35,543
‫يقولون إن المرء يختار عائلته،‬
‫ولقد اخترنا أنا و"أنجليكا" عائلتينا.‬

73
00:05:38,880 --> 00:05:39,881
‫كلنا يا "جاكي".‬

74
00:05:40,965 --> 00:05:43,843
‫أنا و"جورج" والأولاد،‬
‫ما زلنا نريد أن نكون عائلتك.‬

75
00:05:44,427 --> 00:05:45,970
‫أيًا كان ما حدث، يمكننا إصلاحه.‬

76
00:05:47,930 --> 00:05:49,223
‫نريدك أن تعودي إلينا.‬

77
00:05:52,518 --> 00:05:54,437
‫لست متأكدة من استطاعتي.‬

78
00:05:58,316 --> 00:06:01,903
‫حسنًا، سأكون إلى جوارك على أي حال.‬

79
00:06:01,986 --> 00:06:04,155
‫فإن أردت الذهاب إلى "فيرمونت"،‬
‫فسأزورك هناك.‬

80
00:06:04,238 --> 00:06:06,282
‫أعني، من لا يحب ولاية "الجبال الخضراء"؟‬

81
00:06:11,537 --> 00:06:13,039
‫مكانك موجود يا "جاكي".‬

82
00:06:15,291 --> 00:06:16,417
‫معنا.‬

83
00:06:30,098 --> 00:06:36,813
‫"حياتي مع أبناء عائلة (والتر)"‬

84
00:07:02,630 --> 00:07:04,465
‫دائمًا ما تربك المدافعين.‬

85
00:07:19,981 --> 00:07:21,357
‫سيكون كل شيء على ما يُرام.‬

86
00:07:22,233 --> 00:07:24,235
‫وإلا فستخبرينني، اتفقنا؟‬

87
00:07:25,319 --> 00:07:26,279
‫اتفقنا.‬

88
00:07:26,779 --> 00:07:29,282
‫هل قالت لك إنها ستعود؟‬

89
00:07:29,365 --> 00:07:31,367
‫لم أتحدّث إليها منذ غادرت "نيويورك"،‬

90
00:07:31,451 --> 00:07:33,953
‫لكن من الجيد أنها جاءت، صحيح؟‬

91
00:07:38,082 --> 00:07:43,671
‫"مستشفى (سيلفر فولز) البيطري"‬

92
00:07:45,923 --> 00:07:47,717
‫"داني"، أيمكنك أن تساعدني؟‬

93
00:07:54,640 --> 00:07:56,267
‫- هيا.‬
‫- "جاكي"!‬

94
00:07:56,767 --> 00:07:58,352
‫أريدك أن تقابلي "غريغوري بيك".‬

95
00:07:58,436 --> 00:08:00,229
‫حسنًا… من؟ ماذا؟‬

96
00:08:00,313 --> 00:08:01,522
‫إنها دجاجته.‬

97
00:08:02,148 --> 00:08:03,900
‫ربيته منذ أن كان طفلًا.‬

98
00:08:03,983 --> 00:08:05,193
‫بل فرخ يا "بيني".‬

99
00:08:05,276 --> 00:08:06,903
‫- "غريغوري" أنثى.‬
‫- هل هذا مهم؟‬

100
00:08:06,986 --> 00:08:08,571
‫مهم إن أردت بيضًا.‬

101
00:08:08,654 --> 00:08:10,948
‫حسنًا، هيا يا رفاق. هيا.‬

102
00:08:13,117 --> 00:08:14,660
‫"ريد 60"!‬

103
00:08:14,744 --> 00:08:16,954
‫- "آيزك"، هنا!‬
‫- هيا!‬

104
00:08:17,038 --> 00:08:17,872
‫استعداد!‬

105
00:08:20,500 --> 00:08:21,542
‫"جوردان"!‬

106
00:08:22,668 --> 00:08:23,669
‫هيا!‬

107
00:08:23,753 --> 00:08:25,546
‫- هيا يا "جوردان"!‬
‫- شكرًا يا رجل.‬

108
00:08:26,130 --> 00:08:27,048
‫اركض!‬

109
00:08:29,383 --> 00:08:31,177
‫- "جوردان"!‬
‫- هنا!‬

110
00:08:38,184 --> 00:08:39,018
‫"جوردان"!‬

111
00:08:40,478 --> 00:08:41,354
‫مذهل.‬

112
00:08:41,437 --> 00:08:42,396
‫- هذا جيد.‬
‫- مرحبًا!‬

113
00:08:43,105 --> 00:08:43,981
‫مرحبًا.‬

114
00:08:44,065 --> 00:08:45,274
‫"جاكي"!‬

115
00:08:46,692 --> 00:08:47,985
‫- عود حميد.‬
‫- اشتقت إليك.‬

116
00:08:48,069 --> 00:08:49,320
‫- اشتقت إليك أيضًا.‬
‫- اشتقنا إليك.‬

117
00:08:49,403 --> 00:08:50,488
‫شكرًا يا "جورج".‬

118
00:08:52,740 --> 00:08:53,658
‫مرحبًا يا "باركر".‬

119
00:08:54,867 --> 00:08:56,661
‫مرحبًا يا "جاكي". عود حميد.‬

120
00:08:57,161 --> 00:08:58,120
‫تسرني رؤيتك.‬

121
00:09:00,081 --> 00:09:00,915
‫أجل.‬

122
00:09:02,208 --> 00:09:03,042
‫وأنا أيضًا.‬

123
00:09:04,418 --> 00:09:05,836
‫سننهي دراستنا لاحقًا.‬

124
00:09:07,463 --> 00:09:09,924
‫حسنًا، سأذهب وأفرغ أمتعتي.‬

125
00:09:10,007 --> 00:09:12,009
‫أخبريني إن احتجت إلى شيء.‬

126
00:09:13,803 --> 00:09:15,263
‫أخبريني، كيف سار الأمر؟‬

127
00:09:15,346 --> 00:09:17,056
‫كما ترى، لقد جاءت.‬

128
00:09:17,807 --> 00:09:19,100
‫هل أخبرتك بسبب رحيلها؟‬

129
00:09:19,183 --> 00:09:22,937
‫لم تخبرني، لكنني أرى أن كلينا يعرف‬
‫بأن الأمر كانت له علاقة بـ"أليكس" و"كول".‬

130
00:09:24,146 --> 00:09:25,773
‫لنأمل أن يتمكنوا من تجاوز ذلك.‬

131
00:09:25,856 --> 00:09:28,109
‫أظن أن عليّ قضاء المزيد من الوقت معها.‬

132
00:09:28,859 --> 00:09:30,278
‫سنعتني بها.‬

133
00:09:30,778 --> 00:09:32,029
‫سنعتني بهم جميعًا.‬

134
00:09:33,114 --> 00:09:35,199
‫- هل تريدين كوب شاي؟‬
‫- نعم، أرجوك.‬

135
00:09:38,536 --> 00:09:43,124
‫كنت سأرسلها،‬
‫لكنني ارتأيت أن أبقيها هنا لحين عودتك.‬

136
00:09:44,333 --> 00:09:45,334
‫شكرًا يا "نيثان".‬

137
00:09:48,921 --> 00:09:50,673
‫افتقدناك كثيرًا.‬

138
00:09:50,756 --> 00:09:51,591
‫"سكايلر" أيضًا.‬

139
00:09:53,426 --> 00:09:56,721
‫- كيف حاله؟‬
‫- إنه… "سكاي" كعادته.‬

140
00:09:58,431 --> 00:09:59,265
‫و"غريس"؟‬

141
00:09:59,348 --> 00:10:01,851
‫لم نرها كثيرًا في الصيف.‬

142
00:10:02,351 --> 00:10:05,271
‫أرجوك أخبريني‬
‫بأنك أحضرت البابكا الصغيرة من "زيبارز".‬

143
00:10:05,354 --> 00:10:08,941
‫- إنها بلا منازع أفضل…‬
‫- أفضل شيء تذوقته في حياتك؟‬

144
00:10:09,025 --> 00:10:09,942
‫أجل، أعرف.‬

145
00:10:10,484 --> 00:10:12,612
‫لم يتحدث عن شيء غيرها منذ عودته.‬

146
00:10:12,695 --> 00:10:15,114
‫- تحدثت عن غيرها…‬
‫- صحيح، الأفلام في "آي إف سي".‬

147
00:10:15,197 --> 00:10:18,659
‫كيف لي أن أنسى؟‬
‫وبيض بيني في المطعم الذي في شارع "4"،‬

148
00:10:18,743 --> 00:10:21,245
‫ولعبة أحصنة "جين" الدوارة،‬
‫وخط ترام جزيرة "روزفلت"…‬

149
00:10:21,329 --> 00:10:22,413
‫إنها رائعة حقًا.‬

150
00:10:22,496 --> 00:10:24,123
‫لم أنس.‬

151
00:10:24,206 --> 00:10:25,750
‫شكرًا. رائع.‬

152
00:10:26,542 --> 00:10:28,919
‫- أيمكنني أن أجربها؟‬
‫- مستحيل. هذه لي.‬

153
00:10:29,712 --> 00:10:31,255
‫تسرني عودتك يا "جاكي".‬

154
00:10:31,339 --> 00:10:33,174
‫على الأقل لديّ شخص أحب "نيويورك" معه.‬

155
00:10:34,008 --> 00:10:34,842
‫توقّف!‬

156
00:10:37,678 --> 00:10:38,638
‫هل اشتقت إليها؟‬

157
00:10:38,721 --> 00:10:39,847
‫نعم.‬

158
00:10:39,930 --> 00:10:43,601
‫نعم، لكن تسرني أيضًا العودة إلى دياري.‬

159
00:10:44,226 --> 00:10:46,020
‫هل حزن "ريتشارد" على رحيلك؟‬

160
00:10:47,313 --> 00:10:49,398
‫أظن ذلك. لكنه كان مشغولًا جدًا،‬

161
00:10:50,024 --> 00:10:53,486
‫فأعرف أنه سعيد بمجيئي إلى هنا‬
‫بدلًا من "فيرمونت".‬

162
00:10:54,236 --> 00:10:55,154
‫وأنت؟‬

163
00:10:55,237 --> 00:10:57,323
‫أيسعدك مجيئك إلى هنا بدلًا من "فيرمونت"؟‬

164
00:10:58,699 --> 00:11:01,577
‫إنما أستغرب مدى ألفة عودتي‬

165
00:11:02,244 --> 00:11:04,664
‫رغم أنني ما زلت لا أشعر بأن هذا بيتي.‬

166
00:11:05,456 --> 00:11:06,707
‫ليس بعد على الأقل.‬

167
00:11:07,375 --> 00:11:08,417
‫كان صعبًا على الجميع‬

168
00:11:09,585 --> 00:11:10,753
‫رحيلك.‬

169
00:11:10,836 --> 00:11:13,005
‫لكن الجميع سعداء بعودتك.‬

170
00:11:13,089 --> 00:11:14,256
‫الجميع؟‬

171
00:11:15,966 --> 00:11:19,261
‫في الواقع،‬
‫قد يحتاج البعض إلى وقت أكثر من الآخرين.‬

172
00:11:20,346 --> 00:11:21,389
‫لا تقلقي.‬

173
00:11:36,612 --> 00:11:37,613
‫أأنت بخير يا "ب"؟‬

174
00:11:40,866 --> 00:11:42,535
‫لم تودّعني حتى.‬

175
00:11:47,707 --> 00:11:49,166
‫كانت لديها أسباب وجيهة.‬

176
00:11:57,883 --> 00:11:59,677
‫لا بأس في أنك اشتقت إليها.‬

177
00:12:12,106 --> 00:12:13,858
‫بحقك. رفقًا بي.‬

178
00:12:13,941 --> 00:12:15,860
‫أنت غاضب من أنني أفضل فحسب.‬

179
00:12:46,599 --> 00:12:47,433
‫مرحبًا.‬

180
00:12:48,517 --> 00:12:49,435
‫مرحبًا.‬

181
00:12:53,939 --> 00:12:54,774
‫إذًا…‬

182
00:12:56,692 --> 00:12:58,569
‫كيف كانت "مونتانا"؟‬

183
00:12:59,153 --> 00:13:02,198
‫لا تختلف عن هنا تقريبًا. أحصنة وجبال.‬

184
00:13:06,577 --> 00:13:08,412
‫"أليكس"، أنا…‬

185
00:13:09,038 --> 00:13:10,247
‫أحضرت لك هذه.‬

186
00:13:11,207 --> 00:13:16,712
‫قال الرجل في المكتبة‬
‫إن من يحب الخيال العلمي سيجد هذه الأروع.‬

187
00:13:18,088 --> 00:13:19,006
‫إنها سلسلة جديدة.‬

188
00:13:21,383 --> 00:13:25,387
‫شكرًا. لم أعد أحب الخيال.‬

189
00:13:28,641 --> 00:13:30,810
‫"أليكس"، بخصوص رحيلي،‬

190
00:13:30,893 --> 00:13:33,938
‫- أريد أن أشرح لك فحسب…‬
‫- لا بأس. لا تشغلي بالك. أعرف.‬

191
00:13:34,438 --> 00:13:35,773
‫اقترفت خطأً.‬

192
00:13:35,856 --> 00:13:37,900
‫كان يجب ألّا أقول ما قلته.‬

193
00:13:37,983 --> 00:13:40,486
‫- لا، لم يكن بسبب ذلك، بل بسبب…‬
‫- لا يهم السبب.‬

194
00:13:40,569 --> 00:13:42,363
‫لقد رحلت، والآن قد عدت.‬

195
00:13:42,863 --> 00:13:43,697
‫أجل، لكن…‬

196
00:13:43,781 --> 00:13:46,325
‫اسمعي، عليّ أن أعيد "ميرفي"‬
‫قبل المدرسة، مفهوم؟‬

197
00:13:48,202 --> 00:13:49,036
‫مفهوم.‬

198
00:13:58,212 --> 00:13:59,338
‫"أليكس"…‬

199
00:14:03,300 --> 00:14:04,218
‫هل نحن على وفاق؟‬

200
00:14:06,095 --> 00:14:07,763
‫طبعًا، لا مشكلة بيننا.‬

201
00:14:21,777 --> 00:14:23,320
‫- صباح الخير يا "جاكي".‬
‫- صباح الخير.‬

202
00:14:23,404 --> 00:14:24,238
‫مرحبًا.‬

203
00:14:24,321 --> 00:14:26,448
‫ثمة خبز محمص…‬

204
00:14:26,532 --> 00:14:27,867
‫- شكرًا.‬
‫- …و…‬

205
00:14:27,950 --> 00:14:31,203
‫هل نُقل تدريب كرة قدم "باركر"‬
‫إلى حديقة المركز الاجتماعي هذا العام؟‬

206
00:14:31,287 --> 00:14:35,666
‫نعم، وهو متزامن مع تدريب سباحة "بيني"‬
‫في الجهة الأخرى من البلدة.‬

207
00:14:36,542 --> 00:14:37,710
‫يمكنني إنهاء هذه.‬

208
00:14:37,793 --> 00:14:41,005
‫- لا. أنا لها. لا بأس.‬
‫- أنا جادة يا "كاثرين"، دعيني أساعدك.‬

209
00:14:41,088 --> 00:14:42,715
‫- حسنًا. شكرًا.‬
‫- أرجوك.‬

210
00:14:43,424 --> 00:14:44,592
‫عزيزتي.‬

211
00:14:46,260 --> 00:14:48,387
‫لديّ اجتماع جمعية الزراعة اليوم‬
‫في "لوكوود".‬

212
00:14:48,470 --> 00:14:52,057
‫حسنًا، ربما يمكنني توصيل "باركر"‬
‫إلى تدريب كرة القدم‬

213
00:14:52,141 --> 00:14:56,270
‫بعد أن آخذ "جوردان" إلى نادي الأفلام،‬
‫ثم يمكنني العودة وتوصيل "بيني"؟‬

214
00:14:56,353 --> 00:14:58,814
‫سيكون تدريب "بيني" قد انتهى.‬
‫لن تصلي في الموعد.‬

215
00:14:58,898 --> 00:15:01,108
‫- يمكنني الذهاب بالدراجة.‬
‫- لا!‬

216
00:15:01,191 --> 00:15:03,986
‫لماذا نقلوا تدريب كرة القدم؟‬
‫تمكنّا منه في العام الماضي.‬

217
00:15:04,069 --> 00:15:04,904
‫لا أعرف.‬

218
00:15:04,987 --> 00:15:07,656
‫عزيزتي، لا أعرف إن كنت سأجد حلًا‬
‫قبل موعد التدريب.‬

219
00:15:07,740 --> 00:15:09,325
‫لكن الفرق ستُختار هذا الأسبوع.‬

220
00:15:11,118 --> 00:15:13,203
‫- حسنًا، من يريد البيض؟‬
‫- سنجد حلًا.‬

221
00:15:13,287 --> 00:15:15,247
‫- أنا أريد!‬
‫- أنا، لكن ليس سائلًا جدًا.‬

222
00:15:18,000 --> 00:15:19,084
‫المعذرة.‬

223
00:15:20,920 --> 00:15:22,212
‫يا "كول" ويا "داني"،‬

224
00:15:22,296 --> 00:15:25,007
‫أيستطيع أحدكما توصيل "باركر"‬
‫إلى تدريب كرة القدم لاحقًا؟‬

225
00:15:25,090 --> 00:15:26,800
‫لا أستطيع. لديّ مجموعة دراسة.‬

226
00:15:30,387 --> 00:15:31,472
‫ماذا؟‬

227
00:15:34,683 --> 00:15:35,517
‫"داني"؟‬

228
00:15:35,601 --> 00:15:38,020
‫لا أمانع،‬
‫لكنني سأفوت التسجيل في نادي المسرح،‬

229
00:15:38,103 --> 00:15:39,647
‫وسيحددون الأدوار اليوم.‬

230
00:15:40,230 --> 00:15:42,316
‫تحتاج هذه العائلة إلى المزيد من السائقين.‬

231
00:15:42,399 --> 00:15:45,194
‫- اسمعي، سنوصلك.‬
‫- حسنًا.‬

232
00:15:45,778 --> 00:15:48,781
‫وجدتها. سأتصل بـ"ويل". ربما يمكنه توصيلك.‬

233
00:15:48,864 --> 00:15:50,282
‫هذا غداؤكم يا رفاق.‬

234
00:15:50,366 --> 00:15:52,618
‫حسنًا، من كانت مهمته إحضار البيض اليوم؟‬

235
00:15:52,701 --> 00:15:54,411
‫- لم تكن مهمتي. أحضرته يوم الجمعة.‬
‫- ولا أنا.‬

236
00:15:54,495 --> 00:15:56,538
‫- واثق بأنها كانت مهمة "جوردان".‬
‫- اصمت.‬

237
00:15:58,082 --> 00:16:01,377
‫حسنًا، إن أردتم أن تأكلوا هذا الصباح،‬
‫فيُستحسن أن يُحضر أحد المزيد من البيض.‬

238
00:16:01,460 --> 00:16:02,836
‫عليّ الرحيل. وداعًا جميعًا.‬

239
00:16:02,920 --> 00:16:03,837
‫سأُحضره أنا.‬

240
00:16:11,220 --> 00:16:12,262
‫أتحتاجين إلى مساعدة؟‬

241
00:16:14,723 --> 00:16:16,308
‫لا، لست بحاجة إليها.‬

242
00:16:17,518 --> 00:16:18,352
‫شكرًا.‬

243
00:16:24,942 --> 00:16:27,444
‫"جاكي"، أيمكنك التوقف للحظة؟‬

244
00:16:33,033 --> 00:16:35,035
‫يجب أن أوصّل هذه إلى "داني".‬

245
00:16:47,715 --> 00:16:48,549
‫وجدته.‬

246
00:16:49,049 --> 00:16:50,592
‫- شكرًا.‬
‫- على الرحب.‬

247
00:16:50,676 --> 00:16:53,095
‫احرص على أن تسقي "فريدريك"، اتفقنا؟‬

248
00:16:53,595 --> 00:16:54,596
‫"فريدريك"؟‬

249
00:16:54,680 --> 00:16:56,515
‫- نبات التين.‬
‫- حسنًا.‬

250
00:16:56,598 --> 00:16:59,435
‫لكن لا تسقه أكثر من اللازم.‬
‫لا تُغرقه. دونت لك التفاصيل.‬

251
00:16:59,518 --> 00:17:00,352
‫عُلم.‬

252
00:17:01,270 --> 00:17:02,104
‫حسنًا.‬

253
00:17:03,856 --> 00:17:07,609
‫الهاتف والمحفظة وجواز السفر‬
‫وتصريح ركوب الطائرة.‬

254
00:17:12,448 --> 00:17:13,615
‫ما الأمر؟‬

255
00:17:14,408 --> 00:17:15,451
‫- لا أريد الذهاب.‬
‫- ماذا؟‬

256
00:17:15,534 --> 00:17:16,368
‫لا.‬

257
00:17:16,452 --> 00:17:17,703
‫بالطبع تريدين.‬

258
00:17:18,370 --> 00:17:20,247
‫هيا، فصل دراسي كامل في "تشيلي"؟‬

259
00:17:20,956 --> 00:17:22,875
‫ستظلين مشغولة للغاية لثلاثة أشهُر.‬

260
00:17:22,958 --> 00:17:24,084
‫هذا حلمك.‬

261
00:17:28,130 --> 00:17:29,131
‫تعال معي.‬

262
00:17:31,133 --> 00:17:34,178
‫"هيلز"، لقد ناقشنا هذا.‬

263
00:17:35,179 --> 00:17:40,601
‫ماذا سأفعل وأنا عالق في مزرعة بيوديناميكية‬
‫في مكان معزول في "تشيلي"‬

264
00:17:40,684 --> 00:17:42,478
‫بينما تعملين على أطروحتك؟‬

265
00:17:42,561 --> 00:17:43,437
‫صحيح.‬

266
00:17:44,021 --> 00:17:46,231
‫كما أنني سأنشغل هنا بتطوير المزرعة.‬

267
00:17:46,315 --> 00:17:47,149
‫أعرف.‬

268
00:17:47,775 --> 00:17:49,026
‫أعرف. أنت محق.‬

269
00:17:51,028 --> 00:17:52,237
‫سأفتقدك.‬

270
00:17:53,572 --> 00:17:54,406
‫وأنا أيضًا.‬

271
00:17:57,117 --> 00:17:59,620
‫- ليست ثلاثة أشهُر حتى، صحيح؟‬
‫- نعم.‬

272
00:17:59,703 --> 00:18:01,413
‫- ستعودين قبل أن تدركي.‬
‫- أجل.‬

273
00:18:01,997 --> 00:18:05,167
‫إلا إذا قابلت عامل مزرعة تشيليًا مثيرًا.‬

274
00:18:05,250 --> 00:18:08,212
‫- لا، لا تفعلي ذلك.‬
‫- لا أعرف. لن أعدك.‬

275
00:18:08,837 --> 00:18:11,006
‫حسنًا. يجب أن نذهب. هيا.‬

276
00:18:11,090 --> 00:18:11,965
‫حسنًا. انتظر.‬

277
00:18:14,176 --> 00:18:16,553
‫لدينا نحو 20 دقيقة.‬

278
00:18:20,557 --> 00:18:26,146
‫"موطن (بيغ هورنز)‬
‫مدرسة (سيلفر فولز) الثانوية"‬

279
00:18:30,234 --> 00:18:31,693
‫يا للهول، "جاكي"! مرحبًا!‬

280
00:18:31,777 --> 00:18:34,113
‫اشتقت إليك!‬

281
00:18:34,196 --> 00:18:35,155
‫مرحبًا يا "غريس".‬

282
00:18:35,239 --> 00:18:38,617
‫كان الصيف مملًا جدًا حتى أنني كدت أنضم‬
‫إلى جماعة صلاة أمي لأحظى بصحبة.‬

283
00:18:39,201 --> 00:18:40,577
‫ألم تتسكعي مع "سكايلر"؟‬

284
00:18:41,453 --> 00:18:44,540
‫لا. هو و"نيثان" كانا في فقاعة حبهما.‬

285
00:18:44,623 --> 00:18:49,628
‫أتفهمينني؟ فساعدت في الكنيسة،‬
‫وجالست الكثير من الأطفال.‬

286
00:18:49,711 --> 00:18:52,131
‫آسفة لأننا لم نتحدث كثيرًا هذا الصيف.‬

287
00:18:52,214 --> 00:18:53,132
‫لا بأس.‬

288
00:18:53,632 --> 00:18:56,176
‫يمكنك تعويضي بإخباري بكل شيء.‬

289
00:18:56,260 --> 00:18:58,262
‫ما شعورك بعد العودة؟ أما زلت مع "أليكس"؟‬

290
00:18:58,345 --> 00:19:00,013
‫لأن الجميع يتحدثون عن الأمر.‬

291
00:19:00,097 --> 00:19:01,557
‫الأمر معقد.‬

292
00:19:02,266 --> 00:19:03,267
‫كيف؟‬

293
00:19:06,854 --> 00:19:08,021
‫انتظري.‬

294
00:19:10,816 --> 00:19:11,650
‫ماذا؟‬

295
00:19:11,733 --> 00:19:14,236
‫أخبرني بأنه يحبني في زفاف "ويل" و"هيلي".‬

296
00:19:15,070 --> 00:19:17,489
‫"جاكي"! يا للهول! ماذا قلت؟‬

297
00:19:17,573 --> 00:19:21,368
‫- لا شيء. كان ثملًا، لذا…‬
‫- أفلم تقولي إنك تحبينه أيضًا؟‬

298
00:19:21,451 --> 00:19:22,953
‫في الواقع، لم أعرف ماذا أقول.‬

299
00:19:23,745 --> 00:19:25,831
‫"أليكس" لطيف جدًا‬

300
00:19:25,914 --> 00:19:28,083
‫وارتباطي به كان جميلًا جدًا.‬

301
00:19:28,167 --> 00:19:29,543
‫لكن "كول"…‬

302
00:19:30,127 --> 00:19:31,336
‫"كول" ماذا؟‬

303
00:19:31,920 --> 00:19:34,131
‫اكتشفت أنه أصلح إبريق شاي "لوسي" المكسور.‬

304
00:19:34,214 --> 00:19:36,800
‫احتفظ به لي منذ عيد الشكر. ثم…‬

305
00:19:36,884 --> 00:19:39,386
‫ثم ماذا؟ أعددتما الشاي؟ أخبريني!‬

306
00:19:41,138 --> 00:19:43,140
‫لقد… تبادلنا قُبلة.‬

307
00:19:43,223 --> 00:19:45,058
‫قبلت "كول والتر"؟‬

308
00:19:45,893 --> 00:19:47,936
‫"جاكي"، يا للهول. لكنك كنت…‬

309
00:19:48,437 --> 00:19:49,813
‫ألم تكوني مع "أليكس" آنذاك؟‬

310
00:19:50,814 --> 00:19:51,940
‫هل يعرف؟‬

311
00:19:55,277 --> 00:19:56,111
‫"جاكي"، هذا…‬

312
00:19:56,195 --> 00:19:59,364
‫أعرف. لقد أخطأت بشدة.‬

313
00:20:00,866 --> 00:20:02,534
‫إذًا، هل أنت مع "كول" الآن؟‬

314
00:20:02,618 --> 00:20:04,369
‫لا. ماذا؟ لا.‬

315
00:20:04,453 --> 00:20:05,662
‫هل تريدين أن تكوني معه؟‬

316
00:20:05,746 --> 00:20:06,997
‫"غريس"، لا.‬

317
00:20:07,080 --> 00:20:09,666
‫وعلى أي حال، لا يهم ما أريد.‬

318
00:20:09,750 --> 00:20:12,377
‫المهم أن أصوّب الأمور مع الجميع.‬

319
00:20:12,461 --> 00:20:14,713
‫ما معنى ذلك؟ ماذا ستفعلين؟‬

320
00:20:14,796 --> 00:20:17,633
‫أولًا، سألتحق بمدرسة تعليم قيادة السيارات‬
‫لأنني أريد رخصة.‬

321
00:20:17,716 --> 00:20:20,761
‫- حسبت أن سكان "نيويورك" لا يقودون.‬
‫- لم أعد من سكانها.‬

322
00:20:21,303 --> 00:20:23,513
‫ثم عليّ إصلاح الأمور مع "أليكس".‬

323
00:20:25,474 --> 00:20:26,892
‫كئيب جدًا.‬

324
00:20:35,692 --> 00:20:36,568
‫لا بأس.‬

325
00:20:37,611 --> 00:20:38,445
‫طبعًا لا بأس.‬

326
00:20:43,992 --> 00:20:46,787
‫كنت تفعلين ذلك طوال الصباح. من هذا؟‬

327
00:20:47,788 --> 00:20:49,456
‫- "داني".‬
‫- "داني والتر"؟‬

328
00:20:49,539 --> 00:20:51,583
‫تبادلنا الرسائل النصية قليلًا خلال الصيف.‬

329
00:20:52,334 --> 00:20:54,711
‫وما رأي توأمه في ذلك؟‬

330
00:20:55,504 --> 00:20:59,841
‫أيام اهتمامي برأي "كول والتر"‬
‫قد ولّت بلا رجعة.‬

331
00:21:01,510 --> 00:21:03,595
‫"مكتب إخصائية التوجيه"‬

332
00:21:03,679 --> 00:21:04,596
‫ادخل.‬

333
00:21:05,973 --> 00:21:06,974
‫"جاكي"!‬

334
00:21:07,683 --> 00:21:09,476
‫تسرني عودتك. ادخلي.‬

335
00:21:09,559 --> 00:21:11,019
‫- شكرًا.‬
‫- اقعدي.‬

336
00:21:11,728 --> 00:21:13,563
‫غيرت رأيك في موضوع المدرسة الداخلية؟‬

337
00:21:14,398 --> 00:21:16,275
‫طلبت المدرسة درجاتك.‬

338
00:21:16,358 --> 00:21:17,734
‫صحيح. نعم.‬

339
00:21:18,527 --> 00:21:21,488
‫لعلمك، يسرني أنك قررت العودة.‬

340
00:21:21,571 --> 00:21:23,282
‫"سيلفر فولز" محظوظة بوجودك.‬

341
00:21:23,991 --> 00:21:24,825
‫شكرًا.‬

342
00:21:26,076 --> 00:21:28,078
‫تأخرت قليلًا في اختيار المواد الاختيارية.‬

343
00:21:28,161 --> 00:21:30,580
‫حسنًا. لنر.‬

344
00:21:33,375 --> 00:21:37,004
‫- أجل. لم تختاري أي مادة.‬
‫- أود الالتحاق بصف تعليم قيادة السيارات.‬

345
00:21:37,087 --> 00:21:39,256
‫آسفة يا "جاكي"، إنه مكتمل العدد.‬

346
00:21:39,339 --> 00:21:41,258
‫إنه صف ذو إقبال واسع.‬

347
00:21:42,634 --> 00:21:45,887
‫المادة الاختيارية الوحيدة‬
‫التي ما زالت متاحة هي ورشة النجارة.‬

348
00:21:46,805 --> 00:21:47,806
‫ماذا؟‬

349
00:21:48,307 --> 00:21:51,935
‫فكّري في الأمر بهذه الطريقة،‬
‫لن يكُف العالم عن الحاجة إلى الرفوف.‬

350
00:21:54,479 --> 00:21:58,025
‫هنا سيركن الضيوف سياراتهم،‬
‫ثم سيسيرون إلى الخيام من هنا.‬

351
00:21:58,859 --> 00:21:59,943
‫أيمكننا إخراج الخيام…‬

352
00:22:00,027 --> 00:22:02,696
‫سنحتاج إلى أحصنة إضافية،‬
‫فسنوسع الإسطبلات في مرحلة ما،‬

353
00:22:02,779 --> 00:22:05,532
‫لكن يمكننا استئجار أحصنة‬
‫حسب الحاجة في البداية.‬

354
00:22:05,615 --> 00:22:07,284
‫سيكون الطهو الجماعي هنا.‬

355
00:22:07,367 --> 00:22:09,202
‫يجب أن نحصل على رخصة تقديم مشروبات كحولية.‬

356
00:22:09,286 --> 00:22:11,580
‫وسنقوم بجولات استكشاف السماء ليلًا من هنا.‬

357
00:22:12,873 --> 00:22:13,707
‫حسنًا.‬

358
00:22:15,625 --> 00:22:20,297
‫هذا رائع. واضح أنك تعرف ما تفعل،‬
‫لكن أيمكننا إخراج الخيام إلى الحقل الخلفي؟‬

359
00:22:20,964 --> 00:22:22,424
‫لأنني لا أريدها هناك.‬

360
00:22:22,507 --> 00:22:25,677
‫وأيضًا "جولات استكشاف السماء ليلًا"،‬
‫من سيقدمها؟‬

361
00:22:25,761 --> 00:22:27,637
‫أنا وأنت لا نعرف شيئًا عن علم الفلك.‬

362
00:22:27,721 --> 00:22:31,058
‫أجل، سنُحضر من يساعدنا في ذلك،‬
‫وهذا أمر آخر علينا مناقشته.‬

363
00:22:31,641 --> 00:22:35,020
‫العمالة. وضعنا ميزانية لعاملين بدوام كامل،‬
‫لكنني أرى أن أربعة أكثر منطقية.‬

364
00:22:35,103 --> 00:22:35,937
‫أربعة؟‬

365
00:22:36,730 --> 00:22:39,566
‫ألا يُفترض بنا أن نجني المال، لا أن ننفقه؟‬

366
00:22:49,076 --> 00:22:53,038
‫إذًا، أيعرف أحدكم ما المخرطة؟‬

367
00:22:54,831 --> 00:22:55,665
‫لا؟‬

368
00:22:56,666 --> 00:22:58,126
‫حسنًا إذًا.‬

369
00:22:58,627 --> 00:23:00,712
‫تُستخدم المخرطة لتدوير الخشب.‬

370
00:23:01,296 --> 00:23:04,716
‫لصنع الأطباق‬
‫والأعمدة الدوارة وأرجل الأثاث.‬

371
00:23:04,800 --> 00:23:08,095
‫أي شيء بحاجة إلى تدوير.‬

372
00:23:13,683 --> 00:23:14,684
‫كيف سار الأمر؟‬

373
00:23:14,768 --> 00:23:15,769
‫في الواقع،‬

374
00:23:16,728 --> 00:23:20,732
‫بدءًا من الفصل الدراسي التالي،‬
‫سأترك العمل رسميًا.‬

375
00:23:23,276 --> 00:23:25,112
‫أجل، عادت الآنسة "إلسون" من إجازتها،‬

376
00:23:25,195 --> 00:23:28,115
‫وكنت قد أبلغتهم بالرحيل في الواقع،‬
‫فأصبحت أيامي هنا معدودة.‬

377
00:23:28,698 --> 00:23:30,867
‫لكنك لا تزال تعمل حاليًا، صحيح؟‬

378
00:23:30,951 --> 00:23:34,496
‫بدوام جزئي.‬
‫أدرّس المسرح والأدب الإنجليزي للصف الأول.‬

379
00:23:34,579 --> 00:23:36,373
‫وأشرف على نادي الصحافة.‬

380
00:23:36,456 --> 00:23:37,541
‫هذا شيء إيجابي.‬

381
00:23:38,041 --> 00:23:40,877
‫ومن يدري ما قد يحدث‬
‫في الأشهُر القليلة القادمة.‬

382
00:23:42,087 --> 00:23:42,963
‫اسمعي،‬

383
00:23:43,630 --> 00:23:47,342
‫حين رفضت تلك الوظيفة في "لندن"،‬
‫لم أتوقّع أن أصبح عاطلًا عن العمل.‬

384
00:23:47,426 --> 00:23:48,260
‫مهلًا،‬

385
00:23:49,136 --> 00:23:50,637
‫لست عاطلًا عن العمل.‬

386
00:23:51,930 --> 00:23:53,598
‫ستجد شيئًا آخر.‬

387
00:23:54,182 --> 00:23:55,016
‫اسمعي…‬

388
00:23:56,893 --> 00:23:59,563
‫ليس عليك أن تكوني إيجابية هكذا طوال الوقت.‬

389
00:24:00,647 --> 00:24:01,481
‫لكنني‬

390
00:24:02,566 --> 00:24:04,443
‫مؤمنة بقدرتك.‬

391
00:24:04,526 --> 00:24:06,027
‫وأعلم أنك ستبلي بلاءً رائعًا.‬

392
00:24:07,237 --> 00:24:08,071
‫حسنًا.‬

393
00:24:08,989 --> 00:24:11,950
‫سأذهب لتجهيز غرفة الصحافة، اتفقنا؟‬

394
00:24:17,330 --> 00:24:20,375
‫حسنًا، هذا صف تعليم قيادة السيارات.‬
‫أنا المدرب "ألين".‬

395
00:24:20,459 --> 00:24:21,960
‫ليتخذ كل منكم مقعدًا من فضلكم.‬

396
00:24:22,043 --> 00:24:23,211
‫يا "أليكس"،‬

397
00:24:23,795 --> 00:24:25,172
‫أيمكنني أن أقعد هنا؟‬

398
00:24:25,755 --> 00:24:27,048
‫طبعًا، نعم.‬

399
00:24:28,175 --> 00:24:29,176
‫رائع.‬

400
00:24:35,849 --> 00:24:37,601
‫القيادة صعبة.‬

401
00:24:37,684 --> 00:24:39,811
‫- كان رائعًا.‬
‫- عليكم التركيز.‬

402
00:24:40,437 --> 00:24:42,397
‫نعم، انتبهوا من فضلكم. هذه أول حصة.‬

403
00:24:42,898 --> 00:24:45,692
‫"تخفيضات ميزانية وعهود نُقضت:‬
‫أزمة ثانوية (سيلفر فولز)"‬

404
00:24:46,359 --> 00:24:47,277
‫مرحبًا يا هذا.‬

405
00:24:47,360 --> 00:24:48,320
‫مرحبًا.‬

406
00:24:48,904 --> 00:24:50,363
‫- مرحبًا يا "أوليفيا".‬
‫- مرحبًا.‬

407
00:24:51,448 --> 00:24:54,493
‫اسمع، أريد الانضمام إلى الصحيفة.‬

408
00:24:55,076 --> 00:24:56,703
‫ماذا؟ لماذا؟‬

409
00:24:56,786 --> 00:24:59,915
‫قال المعلم المسؤول عن فصلي إننا بحاجة‬
‫إلى المزيد من الأنشطة غير الدراسية،‬

410
00:24:59,998 --> 00:25:02,167
‫وليس لديّ إلا تدريب الموسيقى.‬

411
00:25:02,792 --> 00:25:04,044
‫ولماذا الصحيفة؟‬

412
00:25:04,127 --> 00:25:06,421
‫أحب الكتابة، وأريد أن أتحسّن.‬

413
00:25:06,505 --> 00:25:09,424
‫ورفضوا انضمامي في العام الماضي‬
‫لأنني كنت في الصف الأول.‬

414
00:25:09,508 --> 00:25:12,010
‫لكنني ارتأيت أن رئيس التحرير الجديد‬
‫قد يحابيني.‬

415
00:25:14,304 --> 00:25:16,223
‫يجب أن تكون الصحيفة جيدة هذا العام.‬

416
00:25:17,015 --> 00:25:19,851
‫أريد جعلها جادة أكثر ونشر مقالات أعمق،‬

417
00:25:20,435 --> 00:25:23,855
‫بدلًا من تغطية مباريات كرة القدم‬
‫واجتماعات اتحاد الطلاب فقط.‬

418
00:25:25,482 --> 00:25:28,360
‫- أتريد رؤية النسخة الأولى؟‬
‫- الآن؟ طبعًا.‬

419
00:25:29,736 --> 00:25:32,239
‫خُفضت ميزانية المدرسة كثيرًا.‬

420
00:25:32,739 --> 00:25:35,450
‫وأول ما يستغنون عنه‬
‫عند نقص الأموال الفنون.‬

421
00:25:36,034 --> 00:25:39,329
‫الموسيقى والمسرح وأنشطة ما بعد الدوام‬
‫كلها في خطر.‬

422
00:25:40,330 --> 00:25:42,499
‫لكنني متأكد من أن فريق كرة القدم لن يُمس.‬

423
00:25:44,459 --> 00:25:46,753
‫مهلًا، لن يلغوا حفل الخريف الرسمي، صحيح؟‬

424
00:25:47,671 --> 00:25:48,547
‫آمل ألّا يلغوه.‬

425
00:25:48,630 --> 00:25:52,175
‫لكن تخفيضات الميزانية هذه هائلة.‬
‫كتبت مقالًا خاصًا عنها.‬

426
00:25:52,259 --> 00:25:54,219
‫آمل إضافته‬
‫إلى ملف التقدّم إلى جامعة "جورجتاون".‬

427
00:25:54,302 --> 00:25:57,514
‫ربما أستطيع مساعدتك.‬
‫هل أكون مساعد رئيس التحرير غير الرسمي؟‬

428
00:25:59,558 --> 00:26:01,977
‫عليك قطع شوط طويل‬
‫قبل أن تصبح مساعد رئيس التحرير.‬

429
00:26:04,521 --> 00:26:07,899
‫اسمع، إن انضممت إلى الصحيفة،‬
‫فسأكون رئيسك، لا حبيبك.‬

430
00:26:09,109 --> 00:26:10,318
‫حسنًا يا رئيسي.‬

431
00:26:11,778 --> 00:26:12,654
‫هل قُبلت إذًا؟‬

432
00:26:16,283 --> 00:26:18,702
‫نعم، قُبلت.‬

433
00:26:21,121 --> 00:26:22,414
‫أنت متحمس للغاية.‬

434
00:26:22,497 --> 00:26:23,498
‫أنا متحمس فعلًا.‬

435
00:26:24,249 --> 00:26:26,585
‫حسنًا، يجب أن تخبرني بالفرق بين…‬

436
00:26:26,668 --> 00:26:30,171
‫إنه اليوم الأول. يُفترض به أن يعلّمنا.‬
‫هذا بيت القصيد، أتفهمين قصدي؟‬

437
00:26:33,508 --> 00:26:34,426
‫ماذا؟ هل أنت بخير؟‬

438
00:26:35,218 --> 00:26:37,679
‫نعم. إنما لم أعرف أنه يعرف "روبي" جيدًا.‬

439
00:26:42,058 --> 00:26:44,936
‫- حسبت أن عليك إحضار كتبك.‬
‫- سأُحضرها لاحقًا.‬

440
00:26:55,905 --> 00:26:57,324
‫لا، مستحيل…‬

441
00:27:12,922 --> 00:27:13,965
‫يا رفاق،‬

442
00:27:14,549 --> 00:27:18,178
‫أريد أن أعرب عن مدى سعادتي‬
‫بأننا جميعًا هنا معًا.‬

443
00:27:19,095 --> 00:27:22,015
‫ويا "أليكس" ويا "داني"،‬
‫لقد افتقدناكما كثيرًا هذا الصيف.‬

444
00:27:22,098 --> 00:27:24,017
‫لم أفتقدهما. أحب الهدوء.‬

445
00:27:27,312 --> 00:27:28,688
‫ويا "جاكي"،‬

446
00:27:29,230 --> 00:27:30,815
‫تسعدنا جدًا عودتك إلينا في بيتك.‬

447
00:27:30,899 --> 00:27:32,150
‫أجل، افتقدتك يا "جاكي".‬

448
00:27:32,233 --> 00:27:33,401
‫عادت "جاكي"!‬

449
00:27:34,277 --> 00:27:35,320
‫- نخب "جاكي"!‬
‫- نخب "جاكي"!‬

450
00:27:35,403 --> 00:27:36,363
‫نخب "جاكي".‬

451
00:27:36,863 --> 00:27:39,240
‫هذا أفضل من المدرسة الداخلية، صحيح؟‬

452
00:27:39,741 --> 00:27:40,950
‫- ماذا قال؟‬
‫- ماذا؟‬

453
00:27:41,034 --> 00:27:42,702
‫هل كانت ستلتحق بمدرسة داخلية؟‬

454
00:27:46,414 --> 00:27:48,041
‫أيمكنني الانصراف قليلًا؟‬

455
00:27:50,585 --> 00:27:52,504
‫طبعًا، حتى يصل الطعام.‬

456
00:27:52,587 --> 00:27:53,421
‫شكرًا.‬

457
00:28:03,139 --> 00:28:04,140
‫مرحبًا.‬

458
00:28:05,767 --> 00:28:06,601
‫"كول"،‬

459
00:28:07,435 --> 00:28:09,813
‫نفّذ "آيزك" حركة رائعة اليوم في الملعب‬
‫من تعليمك.‬

460
00:28:10,605 --> 00:28:11,981
‫- لا، لست من علّمه.‬
‫- بحقك،‬

461
00:28:12,065 --> 00:28:14,067
‫أعرف حركات "كول والتر" حين أراها.‬

462
00:28:14,150 --> 00:28:15,652
‫إن كنت مهتمًا،‬

463
00:28:15,735 --> 00:28:18,363
‫فمنصب المدرب المساعد ما زال متاحًا.‬

464
00:28:18,446 --> 00:28:19,280
‫شكرًا.‬

465
00:28:19,364 --> 00:28:20,907
‫لا، لا أظن ذلك.‬

466
00:28:21,700 --> 00:28:23,076
‫حسنًا. استمتع بأمسيتك.‬

467
00:28:25,245 --> 00:28:26,079
‫حضرة المدرب.‬

468
00:28:26,162 --> 00:28:28,331
‫- تسرني رؤيتك. مرحبًا.‬
‫- كيف حالك؟‬

469
00:28:31,251 --> 00:28:32,627
‫"أتطلب موعدًا غراميًا معي يا (داني)؟"‬

470
00:28:33,920 --> 00:28:35,964
‫"داني"، ما هذا؟‬

471
00:28:36,047 --> 00:28:38,258
‫- لا هواتف على الطاولة.‬
‫- آسف.‬

472
00:28:38,341 --> 00:28:41,386
‫كان يراسل فتاة من "نيويورك" منذ عودته.‬

473
00:28:42,679 --> 00:28:45,014
‫- أخيرًا، بعض البيتزا.‬
‫- أحسنت يا "داني".‬

474
00:28:46,766 --> 00:28:49,853
‫- أجل، ربما لاحقًا.‬
‫- ابننا ينضج!‬

475
00:28:50,353 --> 00:28:52,856
‫- ستكون أعواد الخبز أفضل…‬
‫- لو فعلت هذا، لفعلت ذلك.‬

476
00:28:53,773 --> 00:28:54,774
‫أجل. شكرًا.‬

477
00:28:54,858 --> 00:28:56,484
‫يجب أن أصبح قويًا.‬

478
00:29:15,170 --> 00:29:17,172
‫مرحبًا، هل تريدين أي شيء؟‬

479
00:29:18,840 --> 00:29:20,008
‫لا، شكرًا.‬

480
00:29:21,009 --> 00:29:22,177
‫هل أنت بخير؟‬

481
00:29:22,927 --> 00:29:23,762
‫نعم.‬

482
00:29:24,262 --> 00:29:25,722
‫إنما…‬

483
00:29:26,890 --> 00:29:27,807
‫أتأقلم.‬

484
00:29:33,480 --> 00:29:36,107
‫لا أعرف ما حدث له خلال الصيف، لكنه…‬

485
00:29:36,191 --> 00:29:37,025
‫تغيّر؟‬

486
00:29:38,359 --> 00:29:39,611
‫وليس تغييرًا إيجابيًا.‬

487
00:29:45,074 --> 00:29:46,826
‫كنت أراسل هذه الفتاة مؤخرًا.‬

488
00:29:58,171 --> 00:29:59,005
‫الباب مفتوح.‬

489
00:30:01,090 --> 00:30:02,091
‫مرحبًا.‬

490
00:30:03,134 --> 00:30:06,763
‫أردت الاطمئنان عليك.‬
‫أعرف أن اليوم كان صعبًا قليلًا، صحيح؟‬

491
00:30:06,846 --> 00:30:08,848
‫نعم. يبدو أن الأمر سيستغرق بعض الوقت.‬

492
00:30:08,932 --> 00:30:11,684
‫وحاولت الالتحاق بصف تعليم القيادة اليوم،‬
‫وكان مكتملًا.‬

493
00:30:12,936 --> 00:30:15,063
‫- أتريدين تعلّم القيادة؟‬
‫- نعم.‬

494
00:30:15,146 --> 00:30:17,982
‫أريد مساعدتك أنت و"جورج"‬
‫في أنشطة الصغيرين.‬

495
00:30:19,150 --> 00:30:20,777
‫يا لمراعاتك يا "جاكي"!‬

496
00:30:21,653 --> 00:30:25,824
‫وأجل، سيكون مذهلًا أن نحظى بسائق آخر هنا،‬
‫لكن هذه ليست مهمتك.‬

497
00:30:29,786 --> 00:30:31,830
‫لا يجب أن تكوني مفيدة لنرحب بك.‬

498
00:30:31,913 --> 00:30:34,582
‫أريد أن أساهم وأكون جزءًا من العائلة.‬

499
00:30:34,666 --> 00:30:35,875
‫أنت جزء منها بالفعل.‬

500
00:30:37,377 --> 00:30:41,130
‫اسمعي، أثّرت فينا جميعًا‬
‫معرفة أنك لا تريدين أن تكوني معنا،‬

501
00:30:41,214 --> 00:30:42,340
‫حتى ولو لفترة قصيرة.‬

502
00:30:43,132 --> 00:30:44,801
‫وندرك أنك كنت بحاجة إلى فسحة،‬

503
00:30:44,884 --> 00:30:48,054
‫لكن بعض الناس ستراودهم مشاعر حيال ذلك،‬

504
00:30:48,137 --> 00:30:50,390
‫وقد يستغرق ذلك بعض الوقت.‬

505
00:30:53,351 --> 00:30:56,938
‫وآسفة أنني أشعرتك بأن العودة إلى هنا‬
‫ستكون سهلة.‬

506
00:30:58,481 --> 00:30:59,315
‫ليست سهلة،‬

507
00:31:00,108 --> 00:31:01,276
‫ولقد أدركت ذلك الآن.‬

508
00:31:04,153 --> 00:31:06,155
‫لكن إن كان بوسع أحد فعل أمور صعبة،‬

509
00:31:06,990 --> 00:31:07,824
‫فهو أنت.‬

510
00:31:28,595 --> 00:31:30,305
‫مرحبًا. "براندن"؟‬

511
00:31:30,388 --> 00:31:32,599
‫كنت أتساءل إن كنت ترغب‬
‫في مبادلة المادة الاختيارية معي؟‬

512
00:31:32,682 --> 00:31:35,810
‫لا أستطيع. أحتاج إلى رخصة‬
‫لأساعد أبي في توصيل الطلبيات.‬

513
00:31:42,775 --> 00:31:44,193
‫مرحبًا. "ماريا"؟‬

514
00:31:44,819 --> 00:31:46,863
‫لن أبرح صف تعليم القيادة يا "جاكي".‬

515
00:31:50,283 --> 00:31:51,117
‫"جاكي"؟‬

516
00:31:53,244 --> 00:31:54,495
‫سأبدل معك.‬

517
00:31:55,580 --> 00:31:56,873
‫حقًا؟ متأكدة؟‬

518
00:31:58,082 --> 00:32:00,251
‫لديّ دراجتي. سألتحق به في الربيع.‬

519
00:32:00,335 --> 00:32:01,252
‫شكرًا.‬

520
00:32:01,336 --> 00:32:02,170
‫على الرحب.‬

521
00:32:32,283 --> 00:32:33,618
‫مرحبًا.‬

522
00:32:34,202 --> 00:32:35,036
‫مرحبًا.‬

523
00:32:36,412 --> 00:32:38,164
‫لم أعلم أنك تعملين هنا.‬

524
00:32:38,247 --> 00:32:40,458
‫حين تحتاج الآنسة "ليفن" إلى مساعدة فقط.‬

525
00:32:41,668 --> 00:32:42,752
‫أحب الهدوء.‬

526
00:32:43,670 --> 00:32:44,712
‫أفهم قصدك.‬

527
00:32:50,677 --> 00:32:52,387
‫أتحتاج إلى مساعدة في إيجاد أي شيء؟‬

528
00:32:53,262 --> 00:32:54,347
‫لا.‬

529
00:32:58,309 --> 00:32:59,143
‫اسمعي يا "إرين"…‬

530
00:33:01,062 --> 00:33:02,397
‫أنا فقط…‬

531
00:33:03,856 --> 00:33:05,525
‫حين راسلتك قائلًا إنني اشتقت إليك،‬

532
00:33:06,734 --> 00:33:07,568
‫عنيت ذلك.‬

533
00:33:08,695 --> 00:33:09,779
‫وأنا أيضًا.‬

534
00:33:42,437 --> 00:33:44,188
‫مرحبًا يا "جاكي". أهلًا بك.‬

535
00:33:44,772 --> 00:33:47,817
‫سنعمل اليوم في أزواج،‬
‫سنراجع مبادئ القيادة الأساسية فحسب،‬

536
00:33:47,900 --> 00:33:49,193
‫فجدي مقعدًا.‬

537
00:33:52,071 --> 00:33:54,449
‫أريدكم أن تعتبروا عجلة القيادة ساعةً.‬

538
00:33:54,532 --> 00:33:57,160
‫والساعة تخبرنا بالوقت يا "أليكس".‬

539
00:33:57,243 --> 00:33:59,620
‫لقد تأخرت. اقعد من فضلك.‬

540
00:34:07,503 --> 00:34:12,425
‫كما كنت أقول، تغيرت القواعد،‬
‫لكن ما لم يتغير هو سلامتكم.‬

541
00:34:12,508 --> 00:34:16,554
‫المراسلة ووضع الماكياج‬
‫والأكل وأحلام اليقظة،‬

542
00:34:16,637 --> 00:34:18,556
‫كل هذه الأشياء يمكنها أن تسبب الحوادث…‬

543
00:34:23,686 --> 00:34:25,521
‫مرحبًا. "كايلي"، صحيح؟‬

544
00:34:28,274 --> 00:34:29,442
‫كيف انتهى بك المطاف هنا؟‬

545
00:34:30,026 --> 00:34:31,444
‫خذلني شخص.‬

546
00:34:35,073 --> 00:34:36,574
‫هذه مخرطة.‬

547
00:34:36,657 --> 00:34:38,034
‫وما عليك فعله…‬

548
00:34:38,117 --> 00:34:41,579
‫شكرًا. أجيد استخدام المخرطة،‬
‫فقد استخدمتها من قبل.‬

549
00:34:43,164 --> 00:34:43,998
‫رائع.‬

550
00:34:44,665 --> 00:34:46,375
‫تعرف أنك تمسكه رأسًا على عقب، صحيح؟‬

551
00:34:52,507 --> 00:34:53,424
‫طبعًا.‬

552
00:34:58,513 --> 00:34:59,347
‫حسنًا.‬

553
00:35:01,849 --> 00:35:04,977
‫يُفترض بك أن تتفقدي مرآة الرؤية الخلفية‬
‫والمرآة الجانبية.‬

554
00:35:05,728 --> 00:35:06,771
‫حسنًا.‬

555
00:35:08,106 --> 00:35:09,482
‫أتفقدت المنطقة غير المرئية؟‬

556
00:35:11,776 --> 00:35:14,195
‫- لم تعطلي فرامل اليد.‬
‫- هل تريد أن تقود؟‬

557
00:35:14,278 --> 00:35:17,115
‫أنتما تذكرانني بجديّ.‬

558
00:35:18,699 --> 00:35:19,909
‫ارقدي في سلام يا "جيجي".‬

559
00:35:21,119 --> 00:35:22,328
‫"أليكس"، أيمكننا التحدث؟‬

560
00:35:22,411 --> 00:35:23,663
‫نحن نتحدث الآن.‬

561
00:35:23,746 --> 00:35:26,124
‫- عليّ معرفة ما يجري بيننا…‬
‫- ناقشنا هذا من قبل.‬

562
00:35:26,207 --> 00:35:29,460
‫قلت ما قلته، وأنت غادرت من دون وداع،‬

563
00:35:29,544 --> 00:35:32,046
‫فواضح جدًا لي أن لا شيء يجري.‬

564
00:35:32,130 --> 00:35:33,589
‫- "أليكس"…‬
‫- لكنك محقة.‬

565
00:35:33,673 --> 00:35:35,466
‫لم ننفصل رسميًا قط،‬

566
00:35:35,550 --> 00:35:38,427
‫فإن كنت بحاجة إلى إعلان رسمي،‬
‫فلنعلنه الآن.‬

567
00:35:39,178 --> 00:35:40,179
‫ماذا؟‬

568
00:35:40,972 --> 00:35:43,975
‫توقيت الوفاة، 6 سبتمبر…‬

569
00:35:45,268 --> 00:35:46,227
‫في الـ2:45.‬

570
00:35:48,312 --> 00:35:49,313
‫هل أنت راضية؟‬

571
00:35:59,115 --> 00:36:02,160
‫- "كايلز". "كايلي".‬
‫- أين الحاشية؟‬

572
00:36:03,161 --> 00:36:03,995
‫ماذا؟‬

573
00:36:04,078 --> 00:36:05,705
‫متى رأيتك في اليومين الماضيين‬

574
00:36:05,788 --> 00:36:07,456
‫رأيتك في حرملك.‬

575
00:36:07,540 --> 00:36:08,499
‫أعرف.‬

576
00:36:09,041 --> 00:36:10,877
‫الأمر لا يُصدّق يا "كايلز".‬

577
00:36:11,669 --> 00:36:15,756
‫ما لا يُصدّق يا "أليكس"‬
‫أن تكون سعيدًا جدًا بأنك أصبحت…‬

578
00:36:16,716 --> 00:36:18,759
‫لا أعرف، مثل الجميع.‬

579
00:36:20,094 --> 00:36:21,470
‫وما المشكلة؟‬

580
00:36:21,554 --> 00:36:23,931
‫ربما أنا سعيد بأن أكون مثل الجميع.‬

581
00:36:24,557 --> 00:36:27,143
‫ربما عليك أن تكُفي عن محاولتك جاهدة‬
‫أن تكوني دخيلة.‬

582
00:36:27,226 --> 00:36:29,312
‫ربما عندها لن تبقي غاضبة هكذا طوال الوقت.‬

583
00:36:30,646 --> 00:36:32,023
‫لست غاضبة طوال الوقت.‬

584
00:36:32,106 --> 00:36:36,152
‫حقًا؟ لماذا تركت صف تعليم القيادة إذًا؟‬
‫أصبحت "جاكي" الآن شريكتي رغمًا عني.‬

585
00:36:36,235 --> 00:36:38,571
‫لقد سجّلنا في صف تعليم القيادة معًا، أتتذكر؟‬

586
00:36:38,654 --> 00:36:39,530
‫- نعم.‬
‫- نعم.‬

587
00:36:39,614 --> 00:36:42,074
‫وفي الحصة الأولى،‬
‫تركتني لأجل فتاة لا تعرفها.‬

588
00:36:42,658 --> 00:36:44,327
‫- أتقصدين "ماريا"؟‬
‫- أيًا كانت.‬

589
00:36:44,410 --> 00:36:47,288
‫بيت القصيد أننا كنا سنخوضه معًا،‬

590
00:36:47,371 --> 00:36:49,415
‫والآن ما عدنا سنخوضه معًا، وهذا بسببك.‬

591
00:36:49,498 --> 00:36:52,126
‫طلبت أن تقعد هناك. لم أر الأمر بالجلل.‬

592
00:36:52,210 --> 00:36:54,545
‫أجل، أنت محق يا "أليكس". ليس بالأمر الجلل.‬

593
00:36:58,966 --> 00:37:01,552
‫أجل. لست غاضبة على الإطلاق.‬

594
00:37:15,399 --> 00:37:16,234
‫"باركر"؟‬

595
00:37:17,235 --> 00:37:18,444
‫أأستطيع محادثتك قليلًا؟‬

596
00:37:22,365 --> 00:37:24,492
‫أريد أن أعتذر عن رحيلي‬

597
00:37:25,326 --> 00:37:27,245
‫وعن عدم تواصلي معك طوال الصيف.‬

598
00:37:28,246 --> 00:37:29,455
‫اشتقت إليك حقًا.‬

599
00:37:34,210 --> 00:37:38,631
‫والآن بعد أن عدت،‬
‫سأحاول جاهدة أن أكون إلى جانبك.‬

600
00:37:40,675 --> 00:37:44,637
‫وهذا يشمل حصولي على رخصة قيادة‬

601
00:37:44,720 --> 00:37:47,848
‫حتى أستطيع أن أصحبك‬
‫إلى تدريب كرة القدم وأشياء أخرى.‬

602
00:37:48,432 --> 00:37:49,558
‫حقًا؟‬

603
00:37:50,476 --> 00:37:52,311
‫سأكون أشبه بسائقتك الخاصة.‬

604
00:37:56,232 --> 00:37:58,276
‫اشتقت إليك أيضًا نوعًا ما.‬

605
00:38:02,738 --> 00:38:03,739
‫جربي.‬

606
00:38:09,328 --> 00:38:10,955
‫- محاولة جيدة.‬
‫- لم تكن رائعة.‬

607
00:38:13,291 --> 00:38:14,125
‫شكرًا لكما.‬

608
00:38:14,208 --> 00:38:15,084
‫- وداعًا.‬
‫- وداعًا.‬

609
00:38:15,960 --> 00:38:18,379
‫أتنتظر لأعطيك المزيد من النصائح‬
‫في النجارة؟‬

610
00:38:18,879 --> 00:38:21,590
‫أبي لا يقدس وقت العشاء العائلي.‬

611
00:38:24,051 --> 00:38:27,471
‫لا يحدّثني إلا في كرة القدم ومدى فشلي فيها،‬

612
00:38:27,555 --> 00:38:30,641
‫ولم أشعر برغبة في المرور بذلك الليلة.‬

613
00:38:33,644 --> 00:38:34,895
‫آسف على المشاركة الزائدة.‬

614
00:38:36,439 --> 00:38:38,274
‫أنا واثق بأن والديك رائعان، صحيح؟‬

615
00:38:39,567 --> 00:38:40,693
‫أعيش مع جدتي.‬

616
00:38:44,030 --> 00:38:45,698
‫"د"! أأنت وحدك؟‬

617
00:38:45,781 --> 00:38:48,451
‫إنما أتناول مقرمشات ليلية،‬
‫إن كنتم تفهمون قصدي.‬

618
00:38:48,534 --> 00:38:50,578
‫أحضري لي بيتزا بإضافة ببروني‬
‫مع ثلاثة مشروبات غازية.‬

619
00:38:50,661 --> 00:38:52,204
‫"ت ج"! على رسلك.‬

620
00:38:53,539 --> 00:38:55,041
‫سنغلق بعد 20 دقيقة.‬

621
00:38:55,124 --> 00:38:56,334
‫نأكل بسرعة.‬

622
00:39:00,212 --> 00:39:01,464
‫أصرت تجيد القراءة؟‬

623
00:39:01,547 --> 00:39:02,715
‫نعم.‬

624
00:39:02,798 --> 00:39:04,258
‫- مقررات دراسية، أتفهمونني؟‬
‫- علم؟‬

625
00:39:04,342 --> 00:39:05,176
‫كيمياء؟‬

626
00:39:05,259 --> 00:39:08,054
‫- ممزق البيتزا. أدخلها هنا، صحيح؟‬
‫- نعم.‬

627
00:39:23,861 --> 00:39:25,071
‫لماذا أنت سعيد هكذا؟‬

628
00:39:26,947 --> 00:39:29,075
‫لا شيء.‬

629
00:39:33,954 --> 00:39:34,872
‫إذًا،‬

630
00:39:36,290 --> 00:39:38,918
‫هل عرفت أن "أليكس" و"جاكي" انفصلا رسميًا؟‬

631
00:39:42,088 --> 00:39:42,922
‫إذًا؟‬

632
00:39:43,005 --> 00:39:45,424
‫إذًا، ربما عليك الذهاب للتحدث إليها؟‬

633
00:39:49,345 --> 00:39:50,262
‫إنما…‬

634
00:39:51,555 --> 00:39:53,182
‫أعرف كم افتقدتك هذا الصيف.‬

635
00:40:07,363 --> 00:40:08,697
‫كانت هذه على الشرفة.‬

636
00:40:09,448 --> 00:40:11,283
‫قالت أمي إنك ستنقلينها إلى هنا.‬

637
00:40:13,786 --> 00:40:14,787
‫أجل.‬

638
00:40:15,371 --> 00:40:17,790
‫أظن أن الوقت قد حان لأجعل الغرفة غرفتي.‬

639
00:40:25,172 --> 00:40:27,299
‫أيمكنك التوقف عن الهرب مني من فضلك؟‬

640
00:40:36,142 --> 00:40:36,976
‫لا ترحلي.‬

641
00:41:40,331 --> 00:41:43,542
‫ترجمة "أحمد قطب"‬

642
00:41:44,542 --> 00:41:59,542
