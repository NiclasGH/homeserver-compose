‪‏‎.‎أو ما شابه‎‏

278
00:22:57,709 --> 00:22:59,711
‪‏‎.‎ربما يعني أن شيء ما سيحدث‎‏

279
00:23:00,170 --> 00:23:01,254
‪‏‎.‎شيء سيىء‎‏

280
00:23:01,713 --> 00:23:03,256
‪‏‎.‎كان غزالاً وكلباً‎‏

281
00:23:04,257 --> 00:23:05,759
‪‏‎؟‎ما الذي تقوله عن الأشياء الثلاثة‎‏

282
00:23:06,051 --> 00:23:08,344
‪‏‎...‎مرتان‎ ،‎مرة‎‏

283
00:23:42,378 --> 00:23:43,714
‪‏‎!‎انخفضوا جميعاً‎‏

284
00:23:52,473 --> 00:23:53,640
‪‏‎.‎انخفضوا‎ ،‎انخفضوا‎‏

285
00:23:54,099 --> 00:23:55,433
‪‏‎!‎انخفضوا‎‏

286
00:23:55,559 --> 00:23:56,643
‪‏‎!‎انخفضوا‎‏

287
00:24:27,633 --> 00:24:29,175
‪‏‎؟‎لماذا لم تخبرينني مسبقاً‎‏

288
00:24:29,300 --> 00:24:31,386
‪‏‎.‎كنت آمل ألا أضطر إلى ذلك‎ ،‎بصراحة‎‏

289
00:24:31,469 --> 00:24:32,929
‪‏‎؟‎ماذا تعنين‎‏

290
00:24:33,013 --> 00:24:35,098
‪‏‎،‎القراءة الإضافية‎ ،‎كل ما كنت تفعله‎‏

291
00:24:35,181 --> 00:24:37,350
‪‏‏‎،‎المدرسة الصيفية‎
‪‏‎،‎وادخار المال لأجل الدراجة‎‏

292
00:24:37,475 --> 00:24:38,977
‪‏‎...‎رغم أنها تخيفني كثيراً‎‏

293
00:24:39,102 --> 00:24:40,937
‪‏‎.‎لم أرد أن أشوش إيقاعاً جيداً‎ ،‎عزيزي‎‏

294
00:24:41,021 --> 00:24:43,189
‪‏‏‎.‎لن يتوقف هذا‎
‪‏‎.‎سأكون أفضل هذا العام‎‏

295
00:24:43,314 --> 00:24:46,359
‪‏‏‏طالب أفضل وابن أفضل‎
‪‏‎.‎وصديق أفضل وأفضل في كل شيء‎‏

296
00:24:46,484 --> 00:24:47,611
‪‏‎.‎أعدك‎‏

297
00:24:49,154 --> 00:24:50,656
‪‏‎.‎حسناً‎‏

298
00:24:50,781 --> 00:24:52,991
‪‏‏‏إذا لم يكن‎ 215 ‏إنه في غرفة‎
‪‏‎.‎في العمليات‎‏

299
00:24:53,116 --> 00:24:54,325
‪‏‎.‎شكراً‎ ،‎حسناً‎‏

300
00:25:19,392 --> 00:25:21,687
‪‏‎.‎هلا تضغط على زر الطابق الثاني رجاء‎‏

301
00:25:22,312 --> 00:25:23,521
‪‏‎.‎أجل‎‏

302
00:25:27,525 --> 00:25:28,860
‪‏‎.‎شكراً‎‏

303
00:25:41,873 --> 00:25:42,999
‪‏‎؟‎ما هذا‎‏

304
00:25:48,880 --> 00:25:50,548
‪‏‎.‎هلا يشرح لي أحدكم هذا‎‏

305
00:25:53,218 --> 00:25:55,553
‪‏‎؟‎صحيح‎ ،‎لا تمانع مساعدتي قليلًا‎‏

306
00:25:59,057 --> 00:26:00,433
‪‏‎.‎بالطبع‎‏

307
00:26:05,521 --> 00:26:06,648
‪‏‎.‎إليكم فكرة‎‏

308
00:26:06,732 --> 00:26:08,650
‪‏‏‏لِم لا تخرجون هذا المهرج من هنا‎
‪‏‏وتحضرون‎‏

309
00:26:08,734 --> 00:26:10,736
‪‏‎؟‎شخصاً يحتاج عمليةً فعلاً‎‏

310
00:26:11,527 --> 00:26:12,613
‪‏‎!‎الآن‎‏

311
00:26:13,571 --> 00:26:14,948
‪‏‎.‎سأذهب لأدخن‎‏

312
00:28:00,178 --> 00:28:02,680
‪‏‎؟‎ألا تدرك مع مَن تتعامل‎‏

313
00:28:03,181 --> 00:28:04,515
‪‏‎."‎ألفا‎" ‏أنا‎‏

314
00:28:09,896 --> 00:28:11,064
‪‏‎.‎كذلك أنا‎‏

315
00:28:18,529 --> 00:28:20,991
‪‏‎؟‎ألا يفترض أن تكون في المدرسة‎‏

316
00:28:32,043 --> 00:28:33,294
‪‏‎؟"‎بليك‎" ‏آنسة‎‏

317
00:28:33,378 --> 00:28:34,670
‪‏‎؟‎هل أنت بخير‎‏

318
00:28:41,677 --> 00:28:43,847
‪‏‎...‎ذلك‎ ،‎آسف‎‏

319
00:28:45,849 --> 00:28:48,351
‪‏‏‏عندما تشعرين أنك تودين البقاء في البيت‎
‪‏‎.‎فعليك فعل ذلك‎‏

320
00:28:48,434 --> 00:28:49,770
‪‏‎.‎أنا بخير‎‏

321
00:28:50,395 --> 00:28:53,106
‪‏‏‎؟‎الغزال والآن هذا‎ ،‎لكن أبي‎ -‏
‪‏‎.‎أعرف‎ ،‎أعرف‎ -‏‏

322
00:28:53,231 --> 00:28:54,607
‪‏‎.‎يستحيل أن يكون صدفة‎‏

323
00:28:57,903 --> 00:29:00,906
‪‏‏‎،"‎أرجينت‎" ‏سيد‎
‪‏‎؟‎هل لديك معلومات عن هذا‎‏

324
00:29:01,031 --> 00:29:02,573
‪‏‏‎؟‎أنا‎ -‏
‪‏‎.‎أجل‎ -‏‏

325
00:29:02,698 --> 00:29:05,285
‪‏‎...‎كل سلوك الحيوانات الغريب هذا‎‏

326
00:29:05,410 --> 00:29:07,871
‪‏‏‏لا بد أنك قد رأيت‎
‪‏‎؟‎صحيح‎ ،‎شيئاً كهذا مسبقاً‎‏

327
00:29:07,954 --> 00:29:10,874
‪‏‏‏لست متأكداً لما عساي أرى شيئاً كهذا‎
‪‏‎.‎أو أن تعتقد أني فعلت‎‏

328
00:29:13,209 --> 00:29:14,252
‪‏‎.‎آسف‎‏

329
00:29:14,377 --> 00:29:16,587
‪‏‏أقسم على أني سمعت ابني‎‏

330
00:29:16,712 --> 00:29:18,589
‪‏‎.‎يتحدث عن كونك صياد ماهر‎‏

331
00:29:20,425 --> 00:29:21,426
‪‏‎.‎أجل‎‏

332
00:29:22,886 --> 00:29:24,095
‪‏‎.‎لم أعد كذلك‎‏

333
00:29:26,597 --> 00:29:27,682
‪‏‎؟‎هل أنت بخير‎‏

334
00:29:27,766 --> 00:29:28,892
‪‏‎.‎أجل‎‏

335
00:29:36,107 --> 00:29:37,483
‪‏‎".‎لدينا مشكلة خطيرة في المدرسة‎"‏‏

336
00:29:37,608 --> 00:29:39,402
‪‏‏‎..."‎بليك‎" ‏صف الآنسة‎" -‏
‪‏‎؟‎أتخبرني لاحقاً‎ -‏‏

337
00:29:39,485 --> 00:29:41,780
‪‏‏‏أنا متأكد‎ ،‎كلا‎"‏
‪‏‎".‎أن هذا يتطلب نقاشاً فورياً‎‏

338
00:29:41,905 --> 00:29:43,990
‪‏‏‎."‎ديريك‎" ‏لاقيني في بيت‎ ،‎حسناً‎ -‏
‪‏‎؟"‎ديريك‎" -‏‏

339
00:29:44,115 --> 00:29:46,827
‪‏‏‎"...‎ماذا تفعل في‎" -‏
‪‏‎.‎لاقينا هنا فحسب‎ -‏‏

340
00:29:51,414 --> 00:29:52,916
‪‏‎؟‎صحيح‎ ،‎أنت لا تعيش هنا‎‏

341
00:29:53,583 --> 00:29:54,793
‪‏‎.‎كلا‎‏

342
00:29:54,918 --> 00:29:57,128
‪‏‏‎،‎أخذته المقاطعة‎
‪‏‎.‎لكن يوجد شيء هنا أحتاج إليه‎‏

343
00:29:58,171 --> 00:29:59,339
‪‏‎."‎ألفا‎"‎لشفاء جرح من ذئب‎‏

344
00:29:59,464 --> 00:30:00,673
‪‏‎.‎لكنه قد شفي‎ ،‎أجل‎‏

345
00:30:03,259 --> 00:30:04,760
‪‏‎.‎ليس من الداخل‎‏

346
00:30:10,976 --> 00:30:12,643
‪‏‎؟‎هل ستخبرني مَن كان ذلك‎‏

347
00:30:14,020 --> 00:30:15,438
‪‏‎؟‎ذلك‎ "‎ألفا‎" ‏ذئب‎‏

348
00:30:16,147 --> 00:30:17,482
‪‏‎.‎قطيع منافس‎‏

349
00:30:18,984 --> 00:30:20,318
‪‏‎.‎إنها مشكلتي‎‏

350
00:30:21,152 --> 00:30:23,321
‪‏‏‎.‎وقد فعلت‎ ،‎أعرف أنك تريد المساعدة‎
‪‏‎.‎أدين لك بمعروف‎‏

351
00:30:25,991 --> 00:30:27,325
‪‏‎.‎عد إلى البيت الآن‎‏

352
00:30:29,160 --> 00:30:30,703
‪‏‎.‎عد للتصرف كمراهق‎‏

353
00:30:41,381 --> 00:30:42,507
‪‏‎."‎ديريك‎"‏‏

354
00:30:44,134 --> 00:30:46,636
‪‏‎،‎إذا أردت أن ترد لي ذلك المعروف الآن‎‏

355
00:30:48,847 --> 00:30:51,349
‪‏‎.‎هناك شيء يمكنك أن تفعله لأجلي‎‏

356
00:30:54,685 --> 00:30:57,063
‪‏‏‏هل أشعر وحدي بذلك‎
‪‏‏تتحول‎ "‎بيكون هيلز‎" ‏أم أن‎‏

357
00:30:57,355 --> 00:30:59,649
‪‏‏‏إلى منارة للأشياء الغريبة تماماً‎
‪‏‎؟‎والخارقة عن الطبيعة‎‏

358
00:31:01,902 --> 00:31:03,153
‪‏‎؟"‎سكوت ماكول‎" ‏أين‎‏

359
00:31:04,320 --> 00:31:05,530
‪‏‎؟‎صحيح‎ ،"‎أليسون‎" ‏أنت‎‏

360
00:31:05,655 --> 00:31:07,866
‪‏‏‎...‎كيف تعرفين‎ ،‎أجل‎ -‏
‪‏‎؟"‎سكوت‎" ‏أين‎ -‏‏

361
00:31:08,658 --> 00:31:10,326
‪‏‏‎.‎اضطر للمغادرة‎
‪‏‎...‎يفترض أن يعود إلى الصف‎‏

362
00:31:10,410 --> 00:31:11,452
‪‏‎؟‎هل سيعود‎‏

363
00:31:11,536 --> 00:31:13,371
‪‏‎.‎لا داعي للإمساك بها يا عزيزتي‎‏

364
00:31:31,431 --> 00:31:32,557
‪‏‎.‎لقد تسببت لي برضة‎‏

365
00:31:34,392 --> 00:31:35,435
‪‏‎.‎أنا أيضاً‎‏

366
00:31:35,560 --> 00:31:36,937
‪‏‎.‎لنخرجكما من هنا‎ ،‎هيا‎‏

367
00:31:37,062 --> 00:31:38,771
‪‏‎.‎يمكن أن تنتظر المدرسة يوماً آخر‎‏

368
00:31:41,691 --> 00:31:42,858
‪‏‎؟‎عزيزتي‎‏

369
00:31:44,110 --> 00:31:45,320
‪‏‎.‎اسمعي‎‏

370
00:31:45,403 --> 00:31:48,198
‪‏‎.‎ليس عليك أن تقلقي حيال هذا بعد الآن‎‏

371
00:31:48,281 --> 00:31:49,782
‪‏‎؟‎تذكري اتفاقنا‎‏

372
00:31:50,408 --> 00:31:52,827
‪‏‏‎"‎بيكون هيلز‎" ‏سنبقى في‎
‪‏‎.‎فقط إذا لم نتدخل في هذا‎‏

373
00:31:52,911 --> 00:31:54,412
‪‏‎.‎ليست مشكلتنا الآن‎‏

374
00:31:56,915 --> 00:31:58,249
‪‏‎؟‎اتفقنا‎‏

375
00:32:02,712 --> 00:32:04,965
‪‏‎.‎اتصالًا خلال الساعة الماضية‎ 15 ‏وردنا‎‏

376
00:32:05,090 --> 00:32:06,049
‪‏‎"‎مفتوح‎"‏‏

377
00:32:06,132 --> 00:32:09,052
‪‏‏‏هناك غزال انتحاري‎
‪‏‎،‎وطيور تطير عبر النوافذ‎‏

378
00:32:09,135 --> 00:32:10,595
‪‏‎.‎وحيوانات أليفة تتصرف بعنف‎‏

379
00:32:10,720 --> 00:32:14,057
‪‏‏‏بدأت أعتقد‎ ،‎بصراحة‎
‪‏‎.‎أن هناك مشكلة في الماء‎‏

380
00:32:14,140 --> 00:32:17,102
‪‏‏‏كنت سأتصل بك‎ ،‎بصراحة‎
‪‏‎.‎بشأن حادث قد وقع لي‎‏

381
00:32:19,980 --> 00:32:22,315
‪‏‎.‎ظننت أنه قد يكون اقتحاماً‎ ،‎في البداية‎‏

382
00:32:22,440 --> 00:32:27,112
‪‏‏‏شخص مريض يسعى إلى إطلاق‎
‪‏‎.‎اندفاع عنف معين‎‏

383
00:32:27,237 --> 00:32:30,448
‪‏‏‏حتى نظرت عن قرب‎
‪‏‎.‎وأدركت ما حدث بالفعل‎‏

384
00:32:35,786 --> 00:32:37,497
‪‏‎.‎فعلوا ذلك بأنفسهم‎‏

385
00:32:43,962 --> 00:32:45,421
‪‏‎.‎أرى ذلك‎ ،‎أجل‎‏

386
00:32:46,006 --> 00:32:47,423
‪‏‎؟‎صحيح‎ ،‎إنهما عصبتين‎‏

387
00:32:50,426 --> 00:32:51,970
‪‏‎؟‎ماذا تعني‎‏

388
00:32:55,306 --> 00:32:56,641
‪‏‎.‎لا أعلم‎‏

389
00:32:57,142 --> 00:33:00,603
‪‏‎.‎إنه شيء رسمته بأصابعي‎‏

390
00:33:07,443 --> 00:33:09,029
‪‏‎؟‎لماذا هذا مهم جداً بالنسبة إليك‎‏

391
00:33:11,531 --> 00:33:13,533
‪‏‎؟"‎تاتو‎" ‏أتعرف ما تعنيه كلمة‎‏

392
00:33:14,367 --> 00:33:16,161
‪‏‎.‎وضع علامة على شيء‎‏

393
00:33:17,287 --> 00:33:19,164
‪‏‎.‎ذلك باللغة التاهيتية‎‏

394
00:33:19,664 --> 00:33:22,875
‪‏‎.‎تعني جرح مفتوح‎ "‎ساموا‎" ‏بلغة‎‏

395
00:33:25,503 --> 00:33:28,089
‪‏‏‏كنت أعرف أني أريد وشماً‎
‪‏‎.‎عاماً‎ 18 ‏عندما يصبح عمري‎‏

396
00:33:28,173 --> 00:33:29,799
‪‏‎.‎أردت واحداً دائماً‎‏

397
00:33:31,176 --> 00:33:35,055
‪‏‎.‎قررت الحصول عليه الآن ليكون كجائزة‎‏

398
00:33:35,721 --> 00:33:37,015
‪‏‎؟‎على ماذا‎‏

399
00:33:39,684 --> 00:33:42,562
‪‏‏‏لعدم الاتصال أو إرسال رسائل‎
‪‏‎.‎طوال الصيف‎ "‎أليسون‎" ‏إلى‎‏

400
00:33:44,730 --> 00:33:46,899
‪‏‎،‎حتى عندما أردت ذلك بشدة‎‏

401
00:33:47,067 --> 00:33:50,861
‪‏‏‏حتى عندما كان ذلك صعباً جداً‎
‪‏‎.‎ألا أفعل أحياناً‎‏

402
00:33:54,407 --> 00:33:57,202
‪‏‎.‎أحاول منحها المساحة التي تريدها‎‏

403
00:34:01,039 --> 00:34:03,416
‪‏‏‎،‎أشهر‎ 4 ‏بعد مرور‎
‪‏‎.‎ما يزال الأمر مؤلماً‎‏

404
00:34:06,419 --> 00:34:08,213
‪‏‎...‎ما زلت أشعر‎‏

405
00:34:10,423 --> 00:34:12,217
‪‏‎.‎كجرح مفتوح‎‏

406
00:34:12,717 --> 00:34:13,926
‪‏‎.‎أجل‎‏

407
00:34:19,099 --> 00:34:20,766
‪‏‎.‎سيكون الألم شديداً للغاية‎‏

408
00:34:21,434 --> 00:34:23,061
‪‏‎.‎ذلك رائع‎‏

409
00:34:23,186 --> 00:34:24,270
‪‏‎.‎افعل ذلك‎‏

410
00:34:28,066 --> 00:34:29,192
‪‏‎!‎يا للهول‎‏

411
00:34:29,275 --> 00:34:30,860
‪‏‎.‎ذلك كثير بالنسبة إلي‎‏

412
00:34:30,943 --> 00:34:33,279
‪‏‎.‎سأعتبر ذلك كإشارة أن علي الرحيل‎‏

413
00:34:33,404 --> 00:34:34,572
‪‏‎.‎سأنتظر في الخارج‎‏

414
00:34:34,697 --> 00:34:35,823
‪‏‎.‎كلا‎‏

415
00:34:35,906 --> 00:34:37,533
‪‏‎.‎يمكنك المساعدة في تثبيته‎‏

416
00:34:48,086 --> 00:34:49,462
‪‏‎!‎يا للهول‎‏

417
00:35:00,098 --> 00:35:01,307
‪‏‎.‎ثبته‎‏

418
00:35:22,162 --> 00:35:23,454
‪‏‎.‎نجح ذلك‎‏

419
00:35:40,971 --> 00:35:42,682
‪‏‎.‎يبدو دائماً الآن‎‏

420
00:35:42,807 --> 00:35:43,849
‪‏‎.‎أجل‎‏

421
00:35:44,309 --> 00:35:46,311
